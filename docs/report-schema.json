{
  "$defs": {
    "AuthorCount": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "commits": {
          "title": "Commits",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "commits"
      ],
      "title": "AuthorCount",
      "type": "object"
    },
    "EcosystemInfo": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "managers": {
          "items": {
            "type": "string"
          },
          "title": "Managers",
          "type": "array"
        },
        "direct": {
          "default": 0,
          "title": "Direct",
          "type": "integer"
        },
        "total": {
          "default": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "name"
      ],
      "title": "EcosystemInfo",
      "type": "object"
    },
    "JFinding": {
      "properties": {
        "id": {
          "description": "ID kontroly, např. secrets-history",
          "title": "Id",
          "type": "string"
        },
        "fingerprint": {
          "description": "Stabilní hash nálezu pro allowlist",
          "title": "Fingerprint",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/JLocation"
        },
        "snippet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Vždy maskovaná ukázka (AKIA…(20 znaků))",
          "title": "Snippet"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "fixable": {
          "title": "Fixable",
          "type": "boolean"
        },
        "data": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "description": "Podrobnosti kontroly (např. chybějící položky, ID zranitelností)",
          "title": "Data",
          "type": "object"
        }
      },
      "required": [
        "id",
        "fingerprint",
        "severity",
        "category",
        "title",
        "message",
        "location",
        "fixable"
      ],
      "title": "JFinding",
      "type": "object"
    },
    "JLocation": {
      "properties": {
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "commit_date": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Date"
        }
      },
      "title": "JLocation",
      "type": "object"
    },
    "JRepo": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "root": {
          "title": "Root",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "untrusted_owner": {
          "title": "Untrusted Owner",
          "type": "boolean"
        },
        "band": {
          "title": "Band",
          "type": "string"
        },
        "forge": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Forge"
        },
        "visibility": {
          "title": "Visibility",
          "type": "string"
        },
        "archived": {
          "title": "Archived",
          "type": "boolean"
        },
        "web_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Web Url"
        },
        "remotes": {
          "items": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object"
          },
          "title": "Remotes",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/JState"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/JFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "allowlisted": {
          "title": "Allowlisted",
          "type": "integer"
        },
        "skipped": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Skipped",
          "type": "object"
        },
        "errors": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Errors",
          "type": "object"
        },
        "details": {
          "$ref": "#/$defs/RepoDetails",
          "description": "Jazyky, velikost, závislosti, historie a data z hostingu (přidáno v 0.4)"
        }
      },
      "required": [
        "name",
        "path",
        "root",
        "score",
        "untrusted_owner",
        "band",
        "forge",
        "visibility",
        "archived",
        "web_url",
        "remotes",
        "state",
        "counts",
        "findings",
        "allowlisted",
        "skipped",
        "errors"
      ],
      "title": "JRepo",
      "type": "object"
    },
    "JState": {
      "properties": {
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Branch"
        },
        "detached": {
          "title": "Detached",
          "type": "boolean"
        },
        "default_branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Default Branch"
        },
        "uncommitted": {
          "title": "Uncommitted",
          "type": "integer"
        },
        "unpushed": {
          "title": "Unpushed",
          "type": "integer"
        },
        "last_commit": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Commit"
        },
        "pulse_30d": {
          "items": {
            "type": "integer"
          },
          "title": "Pulse 30D",
          "type": "array"
        }
      },
      "required": [
        "branch",
        "detached",
        "default_branch",
        "uncommitted",
        "unpushed",
        "last_commit",
        "pulse_30d"
      ],
      "title": "JState",
      "type": "object"
    },
    "JSummary": {
      "properties": {
        "repos": {
          "title": "Repos",
          "type": "integer"
        },
        "findings": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Findings",
          "type": "object"
        },
        "health": {
          "title": "Health",
          "type": "integer"
        },
        "no_pulse": {
          "title": "No Pulse",
          "type": "integer"
        }
      },
      "required": [
        "repos",
        "findings",
        "health",
        "no_pulse"
      ],
      "title": "JSummary",
      "type": "object"
    },
    "LanguageShare": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "bytes": {
          "title": "Bytes",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "bytes"
      ],
      "title": "LanguageShare",
      "type": "object"
    },
    "RepoDetails": {
      "description": "Popis repa pro kartu a reporty (offline z gitu; `forge_*` z API hostingu).",
      "properties": {
        "languages": {
          "items": {
            "$ref": "#/$defs/LanguageShare"
          },
          "title": "Languages",
          "type": "array"
        },
        "files": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Files"
        },
        "worktree_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Worktree Bytes"
        },
        "git_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Bytes"
        },
        "ecosystems": {
          "items": {
            "$ref": "#/$defs/EcosystemInfo"
          },
          "title": "Ecosystems",
          "type": "array"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "first_commit": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Commit"
        },
        "commits_30d": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commits 30D"
        },
        "commits_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commits Year"
        },
        "authors": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authors"
        },
        "top_authors": {
          "items": {
            "$ref": "#/$defs/AuthorCount"
          },
          "title": "Top Authors",
          "type": "array"
        },
        "branches": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branches"
        },
        "last_tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Tag"
        },
        "last_tag_date": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Tag Date"
        },
        "forge_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forge Description"
        },
        "forge_topics": {
          "items": {
            "type": "string"
          },
          "title": "Forge Topics",
          "type": "array"
        },
        "forge_stars": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forge Stars"
        },
        "forge_forks": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forge Forks"
        },
        "forge_open_issues": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forge Open Issues"
        },
        "forge_created": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forge Created"
        },
        "forge_pushed": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forge Pushed"
        }
      },
      "title": "RepoDetails",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "tool": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Tool",
      "type": "object"
    },
    "generated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Generated At"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "offline": {
      "title": "Offline",
      "type": "boolean"
    },
    "cancelled": {
      "title": "Cancelled",
      "type": "boolean"
    },
    "roots": {
      "items": {
        "type": "string"
      },
      "title": "Roots",
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/JSummary"
    },
    "repos": {
      "items": {
        "$ref": "#/$defs/JRepo"
      },
      "title": "Repos",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "tool",
    "generated_at",
    "started_at",
    "offline",
    "cancelled",
    "roots",
    "summary",
    "repos",
    "warnings"
  ],
  "title": "JReport",
  "type": "object",
  "$id": "https://github.com/Luquas95/repo-doctor/report-schema-v1.json"
}
